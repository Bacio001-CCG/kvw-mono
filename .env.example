# Host ports (browser — Docker publish: host:container)
PUBLIC_HOST_PORT=7000
ADMIN_HOST_PORT=7002
BACKEND_HOST_PORT=7400

# Ports inside the containers
PUBLIC_PORT=3000
ADMIN_PORT=3002
BACKEND_PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kvw
POSTGRES_HOST_PORT=5432

BETTER_AUTH_SECRET=

# --- Local Docker (browser on same machine) ---
BETTER_AUTH_URL=http://localhost:7400
ADMIN_URL=http://localhost:7002
# Empty = admin client uses window.location.hostname + NEXT_PUBLIC_BACKEND_HOST_PORT
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_BACKEND_HOST_PORT=7400
CORS_ORIGINS=http://localhost:7000,http://localhost:7002
COOKIE_SECURE=false

# --- Production (Cloudflare DNS → 103.109.235.91, Proxied) ---
# Public:  https://kvw.cbwd.dev
# Admin:   https://kvwadmin.cbwd.dev
# Backend: https://kvwbackend.cbwd.dev
#
# BETTER_AUTH_URL=https://kvwbackend.cbwd.dev
# ADMIN_URL=https://kvwadmin.cbwd.dev
# NEXT_PUBLIC_BACKEND_URL=https://kvwbackend.cbwd.dev
# CORS_ORIGINS=https://kvw.cbwd.dev,https://kvwadmin.cbwd.dev
# COOKIE_SECURE=true
# Google redirect URI: https://kvwbackend.cbwd.dev/api/auth/callback/google
#
# Note: Docker internal BACKEND_URL=http://backend:4000 is set in compose (container→container).
# The browser must call the public backend hostname, never localhost or backend:4000.

# Google OAuth (redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
