# Host ports (browser)
PUBLIC_HOST_PORT=7000
ADMIN_HOST_PORT=7002
BACKEND_HOST_PORT=7400

# Ports inside the containers
PUBLIC_PORT=3000
ADMIN_PORT=3002
BACKEND_PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kvw
POSTGRES_HOST_PORT=5432

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
ADMIN_URL=http://localhost:3002

CORS_ORIGINS=http://localhost:3000,http://localhost:3002
COOKIE_SECURE=false

# Google OAuth (redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
