# Host ports (browser)
PUBLIC_HOST_PORT=7000
ADMIN_HOST_PORT=7002
BACKEND_HOST_PORT=7400

# Ports inside the containers
PUBLIC_PORT=3000
ADMIN_PORT=3002
BACKEND_PORT=4000

# Browser origins allowed by the API (comma-separated)
CORS_ORIGINS=http://localhost:7000,http://localhost:7002

# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false
